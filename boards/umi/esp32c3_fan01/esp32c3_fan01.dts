/dts-v1/;

#include <espressif/esp32c3/esp32c3.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include "esp32c3_fan01-pinctrl.dtsi"
#include "esp32c3_fan01_partitions.dtsi"

/ {
	model = "umi ESP32C3 FAN01";
	compatible = "umi,esp32c3-fan01";

	chosen {
		zephyr,sram = &sram1;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,display = &ssd1306_128x32;
	};

	aliases {
		watchdog0 = &wdt0;
		i2c-0 = &i2c0;
		pwm-0 = &ledc0;
	};

	buttons: buttons {
		compatible = "gpio-keys";
		debounce-interval-ms = <20>;

		key_press: key_press {
			gpios = <&gpio0 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Key Press (A)";
			zephyr,code = <INPUT_KEY_ENTER>;
		};

		key_left: key_left {
			gpios = <&gpio0 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Key Left (B)";
			zephyr,code = <INPUT_KEY_LEFT>;
		};

		key_right: key_right {
			gpios = <&gpio0 10 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Key Right (D)";
			zephyr,code = <INPUT_KEY_RIGHT>;
		};
	};
};

/* Serial0: RX=GPIO20, TX=GPIO21 */
&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

/* USB Serial/JTAG (GPIO18=DN, GPIO19=DP) */
&usb_serial {
	status = "okay";
};

&trng0 {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&timer0 {
	status = "okay";
};

&timer1 {
	status = "okay";
};

&wifi {
	status = "okay";
};

/* I2C0: SCL=GPIO8, SDA=GPIO9 (SSD1306 128x32 + HUSB238 PD) */
&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	ssd1306_128x32: ssd1306@3c {
		compatible = "solomon,ssd1306";
		reg = <0x3c>;
		width = <128>;
		height = <32>;
		ready-time-ms = <200>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <31>;
		segment-remap;
		com-invdir;
		com-sequential;
		prechargep = <0x22>;
	};

	husb238: husb238@8 {
		compatible = "hynetek,husb238";
		reg = <0x08>;
		status = "okay";
	};
};

/* LEDC0: CH0=GPIO13 (1.5kHz inverted PWM for fan) */
&ledc0 {
	status = "okay";
	pinctrl-0 = <&ledc0_default>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
		inverted;
	};
};

/* ADC1: CH0=GPIO0 (风扇电流), CH1=GPIO1 (风扇电压), CH3=GPIO3 (输入电压) */
&adc0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};
